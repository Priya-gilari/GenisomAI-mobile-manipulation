<?xml version="1.0"?>
<robot name="ZSL-1W" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- the original robot model -->
  <xacro:include filename="$(find zsl1w_description)/urdf/ZSL-1W.urdf"/>

  <!-- a leg joint: position-controlled, starts in standing pose -->
  <xacro:macro name="leg_joint" params="name init">
    <joint name="${name}">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">${init}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- a wheel joint: velocity-controlled -->
  <xacro:macro name="wheel_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <xacro:leg_joint name="FBL_ABAD_JOINT" init="0.0"/>
    <xacro:leg_joint name="FBL_HIP_JOINT"  init="0.8"/>
    <xacro:leg_joint name="FBL_KNEE_JOINT" init="-1.6"/>
    <xacro:leg_joint name="FAR_ABAD_JOINT" init="0.0"/>
    <xacro:leg_joint name="FAR_HIP_JOINT"  init="0.8"/>
    <xacro:leg_joint name="FAR_KNEE_JOINT" init="-1.6"/>
    <xacro:leg_joint name="RAR_ABAD_JOINT" init="0.0"/>
    <xacro:leg_joint name="RAR_HIP_JOINT"  init="0.8"/>
    <xacro:leg_joint name="RAR_KNEE_JOINT" init="-1.6"/>
    <xacro:leg_joint name="RBL_ABAD_JOINT" init="0.0"/>
    <xacro:leg_joint name="RBL_HIP_JOINT"  init="0.8"/>
    <xacro:leg_joint name="RBL_KNEE_JOINT" init="-1.6"/>
    <xacro:wheel_joint name="FBL_FOOT_JOINT"/>
    <xacro:wheel_joint name="FAR_FOOT_JOINT"/>
    <xacro:wheel_joint name="RAR_FOOT_JOINT"/>
    <xacro:wheel_joint name="RBL_FOOT_JOINT"/>
  </ros2_control>

  <!-- Gazebo loads ros2_control with our controller config -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find zsl1w_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- grippy wheels -->
  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel_friction link="FL_FOOT_LINK"/>
  <xacro:wheel_friction link="FR_FOOT_LINK"/>
  <xacro:wheel_friction link="RR_FOOT_LINK"/>
  <xacro:wheel_friction link="RL_FOOT_LINK"/>

  <!-- ===== 2D LiDAR on top of the body ===== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="BASE_LINK"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.12" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal>
          <samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
        </horizontal></scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===== ground-truth pose from Gazebo (used as odometry in simulation) ===== -->
  <gazebo>
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <ros><remapping>odom:=ground_truth</remapping></ros>
      <body_name>BASE_LINK</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>
</robot>
